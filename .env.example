# Copy to `.env` and fill in. Validated by `src/env.ts` (Zod) — a missing or
# malformed required var fails the build.

# Canonical base URL: sitemap, robots, OG tags, JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Sentry (optional — leave empty to disable error monitoring entirely).
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""

# CI only: uploads source maps to Sentry. Leave empty locally.
SENTRY_AUTH_TOKEN=""
